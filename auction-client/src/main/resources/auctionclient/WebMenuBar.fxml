<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import org.kordamp.ikonli.javafx.*?>

<HBox alignment="CENTER" prefWidth="1200.0" style="-fx-background-color: #138eff;" BorderPane.alignment="CENTER" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="auctionclient.controllers.main.WebMenuBarController">
    <children>
      <HBox alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" minWidth="1.0" spacing="5.0" HBox.hgrow="ALWAYS">
         <children>
            <Label alignment="CENTER_RIGHT" style="-fx-font-size: 15; -fx-font-weight: BOLD;" text="Xin chào," textFill="WHITE" />
              <Label fx:id="welcome" style="-fx-font-size: 15; -fx-font-weight: bold;" text="USER" textFill="WHITE">
                  <font>
                      <Font name="System Bold" size="12.0" />
                  </font>
              </Label>
            <Button fx:id="productsMenuButton" alignment="CENTER" mnemonicParsing="false" onAction="#switchToAllProductScene" style="-fx-background-color: transparent; -fx-font-weight: bold; -fx-font-size: 15;" stylesheets="@UnderlineButton.css" text="CÁC SẢN PHẨM ĐẤU GIÁ" textFill="WHITE" />
            <Button fx:id="adminControlPanelButton" alignment="CENTER" mnemonicParsing="false" onAction="#switchToAdminControlPanel" style="-fx-font-size: 15; -fx-font-weight: bold; -fx-background-color: transparent;" stylesheets="@UnderlineButton.css" text="TRUNG TÂM ĐIỀU KHIỂN " textFill="WHITE" />
         </children>
         <HBox.margin>
            <Insets left="10.0" />
         </HBox.margin>
      </HBox>
        <ImageView fitHeight="64.0" fitWidth="110.0" onMouseClicked="#switchToMainScene" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@images/Auction-System.png" />
            </image>
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
        </ImageView>
      <HBox alignment="CENTER_RIGHT" maxWidth="1.7976931348623157E308" minWidth="1.0" spacing="5.0" HBox.hgrow="ALWAYS">
         <children>
              <Button fx:id="userProductListButton" alignment="CENTER" mnemonicParsing="false" onAction="#switchToUserProductListScene" style="-fx-background-color: transparent; -fx-font-size: 15; -fx-font-weight: bold;" stylesheets="@UnderlineButton.css" text="CÁC SẢN PHẨM CỦA BẠN" textFill="WHITE">
                  <font>
                      <Font name="System Bold" size="12.0" />
                  </font>
              </Button>
              <Button fx:id="activities" alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" onAction="#switchToActivitiesScene" style="-fx-background-color: transparent; -fx-font-size: 15; -fx-font-weight: bold;" stylesheets="@UnderlineButton.css" text="HOẠT ĐỘNG" textAlignment="CENTER" textFill="WHITE">
                  <font>
                      <Font name="System Bold" size="12.0" />
                  </font>
              </Button>
            <HBox alignment="CENTER" onMouseClicked="#logOut" style="-fx-background-color: #fe5721; -fx-background-radius: 40;" HBox.hgrow="NEVER">
               <children>
                  <FontIcon iconColor="WHITE" iconLiteral="fas-sign-out-alt" iconSize="25" wrappingWidth="28.5" />
                  <Label alignment="CENTER" style="-fx-font-size: 15; -fx-font-weight: bold;" text="ĐĂNG XUẤT" textFill="WHITE" />
               </children>
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
               <padding>
                  <Insets left="15.0" right="15.0" />
               </padding>
               <HBox.margin>
                  <Insets bottom="10.0" top="10.0" />
               </HBox.margin>
            </HBox>
         </children>
         <HBox.margin>
            <Insets right="10.0" />
         </HBox.margin>
      </HBox>
    </children>
</HBox>
