<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefHeight="664.0" prefWidth="490.0" spacing="20.0" style="-fx-background-radius: 30; -fx-background-color: white; -fx-border-radius: 30; -fx-border-color: #e0e0e0; -fx-border-width: 1;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="auctionclient.controllers.seller.ProductInfoSubmissionController">
   <children>
      <HBox alignment="CENTER" fillHeight="false" prefHeight="25.0" prefWidth="438.0">
         <children>
            <Label prefHeight="56.0" prefWidth="281.0" style="-fx-font-size: 23; -fx-font-weight: Bold;" text="Add New Item" textFill="#007bff" />
            <Region prefHeight="55.0" prefWidth="157.0" HBox.hgrow="ALWAYS" />
            <ImageView fitHeight="63.0" fitWidth="82.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@images/linechartIcon.png" />
               </image>
            </ImageView>
         </children>
      </HBox>
      <Label fx:id="error" text="Label" textFill="RED">
         <font>
            <Font name="System Bold Italic" size="12.0" />
         </font>
      </Label>
      <TextField fx:id="productName" prefHeight="50.0" prefWidth="440.0" promptText="Tên Sản Phẩm" style="-fx-background-radius: 10;">
         <font>
            <Font size="15.0" />
         </font>
         <cursor>
            <Cursor fx:constant="TEXT" />
         </cursor>
         <VBox.margin>
            <Insets top="15.0" />
         </VBox.margin>
      </TextField>
      <TextArea fx:id="productDescription" prefHeight="50.0" prefWidth="438.0" promptText="Mô Tả" style="-fx-background-radius: 10;">
         <font>
            <Font size="15.0" />
         </font>
         <opaqueInsets>
            <Insets />
         </opaqueInsets>
         <VBox.margin>
            <Insets />
         </VBox.margin>
         <cursor>
            <Cursor fx:constant="TEXT" />
         </cursor>
      </TextArea>
      <HBox alignment="CENTER" prefHeight="50.0" prefWidth="438.0">
         <children>
            <TextField fx:id="startingPrice" prefHeight="50.0" prefWidth="195.5" promptText="Giá Khởi Điểm" style="-fx-background-radius: 10;" HBox.hgrow="ALWAYS">
               <font>
                  <Font size="15.0" />
               </font>
               <cursor>
                  <Cursor fx:constant="TEXT" />
               </cursor>
            </TextField>
            <Region prefHeight="46.0" prefWidth="28.0" />
            <TextField fx:id="buyoutPrice" prefHeight="50.0" prefWidth="195.5" promptText="Giá Mua" style="-fx-background-radius: 10;" HBox.hgrow="ALWAYS">
               <font>
                  <Font size="15.0" />
               </font>
               <cursor>
                  <Cursor fx:constant="TEXT" />
               </cursor>
            </TextField>
         </children>
      </HBox>
      <HBox prefHeight="50.0" prefWidth="438.0">
         <children>
            <TextField fx:id="tickSize" prefHeight="50.0" prefWidth="205.0" promptText="Bước Giá" style="-fx-background-radius: 10;">
               <font>
                  <Font size="15.0" />
               </font>
               <cursor>
                  <Cursor fx:constant="TEXT" />
               </cursor>
            </TextField>
            <Region prefHeight="50.0" prefWidth="31.0" />
            <ChoiceBox fx:id="types" prefHeight="40.0" prefWidth="207.0" />
         </children>
      </HBox>
      <TextField fx:id="typeSpecificField" prefHeight="50.0" prefWidth="440.0" promptText="Hoạ Sĩ / Mẫu Mã / Thương Hiệu" style="-fx-background-radius: 10;">
         <font>
            <Font size="15.0" />
         </font>
         <cursor>
            <Cursor fx:constant="TEXT" />
         </cursor>
      </TextField>
      <TextField fx:id="bidDurationField" prefHeight="50.0" prefWidth="440.0" promptText="Thời Gian Đấu Giá (phút)" style="-fx-background-radius: 10;">
         <font>
            <Font size="15.0" />
         </font>
         <cursor>
            <Cursor fx:constant="TEXT" />
         </cursor>
      </TextField>
      <HBox alignment="CENTER_RIGHT" prefHeight="33.0" prefWidth="438.0">
         <children>
            <CheckBox fx:id="antiSnippingCheckbox" contentDisplay="CENTER" mnemonicParsing="false" nodeOrientation="RIGHT_TO_LEFT" prefHeight="27.0" prefWidth="154.0" style="-fx-font-size: 13;" text="Cho phép Anti-Snipping" />
         </children>
      </HBox>
      <HBox alignment="CENTER_LEFT" prefHeight="80.0" prefWidth="438.0" VBox.vgrow="ALWAYS">
         <children>
            <Button alignment="CENTER" mnemonicParsing="false" onAction="#switchToUserProductList" style="-fx-font-size: 15; -fx-font-weight: bold; -fx-padding: 15 75 15 75; -fx-background-radius: 10; -fx-background-color: #E0E0E0;" text="HUỶ" HBox.hgrow="ALWAYS">
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor></Button>
            <Region prefHeight="200.0" prefWidth="0.0" HBox.hgrow="ALWAYS" />
            <Button fx:id="submitButton" mnemonicParsing="false" onAction="#addItem" style="-fx-font-size: 15; -fx-font-weight: bold; -fx-padding: 15 67 15 67; -fx-background-radius: 10; -fx-background-color: #007bff;" text="ĐĂNG BÁN" textFill="WHITE" HBox.hgrow="ALWAYS">
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor></Button>
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
   </padding>
</VBox>
