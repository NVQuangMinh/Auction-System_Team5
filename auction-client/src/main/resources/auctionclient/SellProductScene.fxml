<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane xmlns="http://javafx.com/javafx/17.0.12"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="auctionclient.controllers.seller.SellProductSceneController">
   <children>
      <BorderPane prefHeight="600.0" prefWidth="1200.0"
                  style="-fx-background-color: #f6f8ef;">
         <top>
             <fx:include fx:id="menuBar" source="WebMenuBar.fxml" />
         </top>
         <center>
            <VBox style="-fx-background-color: #f6f8ef;">
               <padding>
                  <Insets left="40.0" right="40.0" top="20.0" bottom="20.0"/>
               </padding>

               <!-- ── Toolbar ── -->
               <HBox alignment="CENTER_LEFT" prefHeight="48.0" spacing="12.0">
                  <VBox.margin><Insets bottom="14.0"/></VBox.margin>
                  <Label text="Sản phẩm của tôi"
                         style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                  <Region HBox.hgrow="ALWAYS"/>
                  <Button mnemonicParsing="false"
                          onAction="#handleUserAddItem"
                          text="+ ĐĂNG BÁN SẢN PHẨM"
                          style="-fx-background-color: #138EFF;
                                 -fx-font-size: 14;
                                 -fx-font-weight: bold;
                                 -fx-background-radius: 25;
                                 -fx-padding: 8 22 8 22;
                                 -fx-text-fill: white;
                                 -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.25), 10, 0, 0, 4);">
                     <cursor><Cursor fx:constant="HAND"/></cursor>
                  </Button>
               </HBox>

               <!-- ── 2 Dãy Nằm Ngang: Đang Bán | Đã Bán ── -->
               <VBox spacing="24.0" VBox.vgrow="ALWAYS">

                  <!-- DÃY TRÊN: Đang bán -->
                  <VBox VBox.vgrow="ALWAYS" spacing="12.0">
                     <HBox>
                        <Label text="🟢 ĐANG BÁN"
                               style="-fx-background-color: #138EFF;
                                      -fx-font-size: 14;
                                      -fx-font-weight: bold;
                                      -fx-background-radius: 25;
                                      -fx-padding: 8 22 8 22;
                                      -fx-text-fill: white;
                                      -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.25), 10, 0, 0, 4);"/>
                     </HBox>
                     <ScrollPane fitToHeight="true"
                                 vbarPolicy="NEVER"
                                 hbarPolicy="AS_NEEDED"
                                 VBox.vgrow="ALWAYS"
                                 style="-fx-background: #f6f8ef;
                                        -fx-background-color: transparent;
                                        -fx-border-color: transparent;
                                        -fx-padding: 0;">
                        <FlowPane fx:id="sellingFlowPane"
                                  alignment="CENTER_LEFT"
                                  orientation="VERTICAL"
                                  hgap="20.0" vgap="20.0">
                           <padding>
                              <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                           </padding>
                        </FlowPane>
                     </ScrollPane>
                  </VBox>

                  <!-- DÃY DƯỚI: Đã bán -->
                  <VBox VBox.vgrow="ALWAYS" spacing="12.0">
                     <HBox>
                        <Label text="✅ ĐÃ BÁN"
                               style="-fx-background-color: #34A853;
                                      -fx-font-size: 14;
                                      -fx-font-weight: bold;
                                      -fx-background-radius: 25;
                                      -fx-padding: 8 22 8 22;
                                      -fx-text-fill: white;
                                      -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.25), 10, 0, 0, 4);"/>
                     </HBox>
                     <ScrollPane fitToHeight="true"
                                 vbarPolicy="NEVER"
                                 hbarPolicy="AS_NEEDED"
                                 VBox.vgrow="ALWAYS"
                                 style="-fx-background: #f6f8ef;
                                        -fx-background-color: transparent;
                                        -fx-border-color: transparent;
                                        -fx-padding: 0;">
                        <FlowPane fx:id="soldFlowPane"
                                  alignment="CENTER_LEFT"
                                  orientation="VERTICAL"
                                  hgap="20.0" vgap="20.0">
                           <padding>
                              <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                           </padding>
                        </FlowPane>
                     </ScrollPane>
                  </VBox>

               </VBox>
            </VBox>
         </center>
      </BorderPane>

      <!-- Overlay mờ khi mở modal đăng bán -->
      <AnchorPane fx:id="overlayPane"
                  opacity="0.21"
                  style="-fx-background-color: #000000;"
                  visible="false"/>
   </children>
</StackPane>
