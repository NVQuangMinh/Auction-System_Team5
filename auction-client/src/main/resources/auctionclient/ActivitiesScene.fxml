<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="600.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="auctionclient.controllers.notification.UserActivitiesController">
    <top>
        <fx:include source="WebMenuBar.fxml" />
    </top>
    <center>
      <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" prefHeight="1997.0" prefWidth="1200.0" BorderPane.alignment="TOP_CENTER">
         <content>
            <VBox spacing="10.0">
               <padding>
                  <Insets left="90.0" right="90.0" top="30.0" />
               </padding>
               <children>
                  <Button mnemonicParsing="false" style="-fx-background-color: #f3ece3; -fx-label-padding: 1 31.5 1 31.5; -fx-font-size: 16; -fx-font-weight: bold; -fx-background-radius: 25; -fx-effect: dropshadow(three-pass-box, rgba(0, 0, 0, 0.4), 15, 0, 0, 5);" text="HOẠT ĐỘNG" />
                  <VBox fx:id="notificationContainer" prefHeight="200.0" prefWidth="100.0" />
               </children>
            </VBox>
         </content>
      </ScrollPane>
    </center>
</BorderPane>
