<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.paint.*?>
<?import javafx.scene.text.*?>

<StackPane style="-fx-background-color: transparent;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="auction_client.controllers.BidProductInfoController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>
    <children>
        <HBox prefHeight="500.0" prefWidth="1000.0" spacing="40.0" style="-fx-background-radius: 20; -fx-background-color: #f0f0f0;">
            <children>
                <VBox prefHeight="475.0" prefWidth="450.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label fx:id="itemName" prefHeight="57.0" prefWidth="498.0" style="-fx-font-size: 25; -fx-font-weight: bold;" text="Product Name" textFill="#fc5421">
                            <opaqueInsets>
                                <Insets />
                            </opaqueInsets>
                        </Label>
                        <Label fx:id="description" prefHeight="42.0" prefWidth="465.0" style="-fx-font-size: 16;" text="Description">
                            <VBox.margin>
                                <Insets bottom="14.0" />
                            </VBox.margin>
                        </Label>
                        <GridPane alignment="CENTER" prefHeight="150.0" prefWidth="458.0" style="-fx-background-color: #e9e4de; -fx-background-radius: 15;">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints maxHeight="48.0" minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="70.0" vgrow="ALWAYS" />
                            </rowConstraints>
                            <children>
                                <Label alignment="CENTER" prefHeight="25.0" prefWidth="129.0" style="-fx-font-weight: bold; -fx-font-size: 20;" text="Current Price" textAlignment="CENTER" textFill="#0000006a" GridPane.halignment="CENTER" GridPane.hgrow="ALWAYS" GridPane.valignment="BOTTOM" GridPane.vgrow="ALWAYS" />
                                <Label alignment="CENTER" prefHeight="25.0" prefWidth="169.0" style="-fx-font-weight: bold; -fx-font-size: 20;" text="Buy Out" textAlignment="CENTER" textFill="#0000006a" GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.hgrow="ALWAYS" GridPane.valignment="BOTTOM" GridPane.vgrow="ALWAYS" />
                                <Label alignment="CENTER" prefHeight="25.0" prefWidth="337.0" style="-fx-font-weight: bold; -fx-font-size: 20;" text="Tick Rate" textAlignment="CENTER" textFill="#0000006a" GridPane.columnIndex="2" GridPane.halignment="CENTER" GridPane.hgrow="ALWAYS" GridPane.valignment="BOTTOM" GridPane.vgrow="ALWAYS" />
                                <Label alignment="CENTER" prefHeight="25.0" prefWidth="767.0" style="-fx-font-weight: bold; -fx-font-size: 20;" text="Time Left" textAlignment="CENTER" textFill="#0000006a" GridPane.columnIndex="3" GridPane.halignment="CENTER" GridPane.hgrow="ALWAYS" GridPane.valignment="BOTTOM" GridPane.vgrow="ALWAYS" />
                                <HBox alignment="CENTER" GridPane.halignment="CENTER" GridPane.hgrow="ALWAYS" GridPane.rowIndex="1" GridPane.valignment="TOP" GridPane.vgrow="ALWAYS">
                                    <children>
                                        <Label fx:id="currentPrice" style="-fx-font-size: 28; -fx-font-weight: bold;" text="00" wrapText="true" />
                                    </children>
                                    <padding>
                                        <Insets bottom="10.0" />
                                    </padding>
                                </HBox>
                                <HBox alignment="CENTER" GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.hgrow="ALWAYS" GridPane.rowIndex="1" GridPane.valignment="TOP" GridPane.vgrow="ALWAYS">
                                    <children>
                                        <Label fx:id="buyOut" style="-fx-font-size: 28; -fx-font-weight: bold;" text="00" wrapText="true" HBox.hgrow="ALWAYS" />
                                    </children>
                                    <padding>
                                        <Insets bottom="10.0" />
                                    </padding>
                                </HBox>
                                <HBox alignment="CENTER" GridPane.columnIndex="2" GridPane.halignment="CENTER" GridPane.hgrow="ALWAYS" GridPane.rowIndex="1" GridPane.valignment="TOP" GridPane.vgrow="ALWAYS">
                                    <children>
                                        <Label fx:id="tickRate" style="-fx-font-size: 28; -fx-font-weight: bold;" text="00" wrapText="true" />
                                    </children>
                                    <padding>
                                        <Insets bottom="10.0" />
                                    </padding>
                                </HBox>
                                <Label fx:id="timeLeft" alignment="CENTER" prefHeight="84.0" prefWidth="295.0" style="-fx-font-size: 25; -fx-font-weight: bold;" text=" " textFill="RED" GridPane.columnIndex="3" GridPane.rowIndex="1">
                                    <padding>
                                        <Insets bottom="10.0" left="5.0" />
                                    </padding>
                                </Label>
                            </children>
                            <VBox.margin>
                                <Insets bottom="25.0" />
                            </VBox.margin>
                            <padding>
                                <Insets left="5.0" right="5.0" />
                            </padding>
                        </GridPane>
                        <HBox alignment="CENTER_LEFT" prefHeight="17.0" prefWidth="488.0">
                            <children>
                                <Label prefHeight="17.0" prefWidth="208.0" style="-fx-font-size: 16; -fx-font-weight: bold;" text="Place your bid:" />
                                <Region prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />
                                <CheckBox fx:id="autoBidCheck" mnemonicParsing="false" nodeOrientation="RIGHT_TO_LEFT" prefHeight="17.0" prefWidth="162.0" style="-fx-font-size: 15;" text="Auto Bidding">
                                    <cursor>
                                        <Cursor fx:constant="HAND" />
                                    </cursor>
                                </CheckBox>
                            </children>
                        </HBox>
                        <HBox fx:id="bidContainer" alignment="CENTER_LEFT" prefHeight="80.0" prefWidth="500.0">
                            <children>
                                <TextField fx:id="bidAmount" prefHeight="80.0" prefWidth="305.0" promptText="ENTER YOUR PRICE" style="-fx-font-size: 24; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-width: 2; -fx-border-color: #dcdcdc;" />
                                <Region prefHeight="131.0" prefWidth="46.0" HBox.hgrow="ALWAYS" />
                                <Button mnemonicParsing="false" onAction="#placeBidRequest" prefHeight="129.0" prefWidth="150.0" style="-fx-background-color: #fe5721; -fx-font-size: 17; -fx-font-weight: bold; -fx-background-radius: 10;" text="PLACE&#10;BID&#10;&#10;" textAlignment="CENTER" textFill="WHITE" />
                            </children>
                            <VBox.margin>
                                <Insets top="14.0" />
                            </VBox.margin>
                        </HBox>
                        <HBox fx:id="autoBidContainer" managed="false" prefHeight="80.0" prefWidth="500.0" visible="false">
                            <children>
                                <TextField fx:id="maxPrice" prefHeight="80.0" prefWidth="305.0" promptText="ENTER YOUR MAX PRICE" style="-fx-font-size: 24; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-width: 2; -fx-border-color: #dcdcdc;" />
                                <Region prefHeight="131.0" prefWidth="46.0" HBox.hgrow="ALWAYS" />
                                <Button fx:id="autoPlaceBid" mnemonicParsing="false" prefHeight="129.0" prefWidth="150.0" style="-fx-background-color: #fe5721; -fx-font-size: 17; -fx-font-weight: bold; -fx-background-radius: 10;" text="PLACE&#10;BID&#10;&#10;" textAlignment="CENTER" textFill="WHITE" />
                            </children>
                            <VBox.margin>
                                <Insets top="14.0" />
                            </VBox.margin>
                        </HBox>
                  <Label fx:id="error" text="Label" textFill="RED">
                     <font>
                        <Font name="System Bold Italic" size="14.0" />
                     </font>
                  </Label>
                        <Label prefHeight="32.0" prefWidth="490.0" style="-fx-font-size: 13;" text="Bidding in the last 30s extend the timer by 60s." textFill="#00000091" />
                    </children>
                </VBox>
                <VBox prefHeight="475.0" prefWidth="247.0" spacing="15.0" HBox.hgrow="ALWAYS">
                    <children>
                        <HBox alignment="CENTER_LEFT" prefHeight="57.0" prefWidth="498.0">
                            <children>
                                <ImageView fitHeight="57.0" fitWidth="67.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@images/linechartIcon.png" />
                                    </image>
                                    <HBox.margin>
                                        <Insets left="10.0" />
                                    </HBox.margin>
                                </ImageView>
                                <Label prefHeight="64.0" prefWidth="459.0" style="-fx-font-size: 25; -fx-font-weight: bold;" text="Price History" />
                                <Label fx:id="closeButton" alignment="TOP_RIGHT" onMouseClicked="#switchToUserProductList" prefHeight="99.0" prefWidth="154.0" style="-fx-font-size: 18; -fx-font-weight: bold;" text="X" textFill="#00000052">
                                    <cursor>
                                        <Cursor fx:constant="HAND" />
                                    </cursor>
                                </Label>
                            </children>
                        </HBox>
                        <AnchorPane prefHeight="316.0" prefWidth="451.0" style="-fx-background-color: #f0f0f0; -fx-background-radius: 15; -fx-border-color: #dcdcdc; -fx-border-width: 2; -fx-border-radius: 15;">
                            <children>
                                <LineChart fx:id="bidHistory" horizontalGridLinesVisible="false" layoutX="4.0" layoutY="4.0" legendVisible="false" prefHeight="316.0" prefWidth="451.0" style="-fx-background-color: transparent;" verticalGridLinesVisible="false" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
                                    <xAxis>
                                        <CategoryAxis tickMarkVisible="false" fx:id="xAxis" />
                                    </xAxis>
                                    <yAxis>
                                        <NumberAxis fx:id="yAxis" forceZeroInRange="false" side="LEFT" tickMarkVisible="false" />
                                    </yAxis>
                                </LineChart>
                            </children>
                        </AnchorPane>
                    </children>
                </VBox>
            </children>
            <padding>
                <Insets left="20.0" right="20.0" top="25.0" />
            </padding>
            <effect>
                <DropShadow height="60.0" radius="29.5" width="60.0">
                    <color>
                        <Color opacity="0.25" />
                    </color>
                </DropShadow>
            </effect>
        </HBox>
    </children>
</StackPane>
