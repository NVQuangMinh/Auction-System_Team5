<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.StackPane?>


<StackPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="auction_client.controllers.BidProductSceneController">
   <children>
      <BorderPane fx:id="MainPane" style="-fx-background-color: #f6f8ef;">
         <top>
            <fx:include fx:id="menuBar" source="WebMenuBar.fxml" />
         </top>
         <center>
            <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" BorderPane.alignment="CENTER">
               <content>
                  <FlowPane fx:id="productFlowPane" hgap="20.0" prefHeight="200.0" prefWidth="200.0" vgap="20.0">
                     <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                     </padding>
                  </FlowPane>
               </content>
            </ScrollPane>
         </center>
      </BorderPane>
      <AnchorPane fx:id="overlayPane" opacity="0.21" prefHeight="200.0" prefWidth="200.0" style="-fx-background-color: #000000;" visible="false" />
   </children>
</StackPane>
