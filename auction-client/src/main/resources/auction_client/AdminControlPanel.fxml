<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="auction_client.controllers.AdminControlPanelController">
    <children>
        <BorderPane prefHeight="600.0" prefWidth="1200.0">
            <top>
                <fx:include fx:id="menuBar" source="WebMenuBar.fxml" />
            </top>
            <center>
                <ScrollPane fitToHeight="true" fitToWidth="true" BorderPane.alignment="CENTER">
                    <content>
                        <VBox alignment="TOP_CENTER" spacing="30.0" style="-fx-background-radius: 8;">
                            <children>
                                <HBox alignment="CENTER_LEFT" prefHeight="21.0" prefWidth="1018.0">
                                    <children>
                                        <Button mnemonicParsing="false" style="-fx-background-color: #FF8E8E; -fx-label-padding: 1 31.5 1 31.5; -fx-font-size: 16; -fx-font-weight: bold; -fx-background-radius: 25;" text="YOUR LISTING" textFill="#b03a2e" />
                                    </children>
                                    <VBox.margin>
                                        <Insets />
                                    </VBox.margin>
                                </HBox>
                                <VBox spacing="15.0">
                                    <children>
                                        <TableView fx:id="userTable" nodeOrientation="LEFT_TO_RIGHT" prefHeight="200.0" stylesheets="@TableStyle.css">
                                            <columns>
                                                <TableColumn fx:id="colUserId" editable="false" maxWidth="80.0" minWidth="80.0" reorderable="false" sortable="false" text="ID" />

                                                <TableColumn fx:id="colUsername" editable="false" minWidth="400.0" prefWidth="400.0" reorderable="false" sortable="false" text="Username" />

                                                <TableColumn fx:id="colUserRole" editable="false" minWidth="300.0" prefWidth="300.0" reorderable="false" sortable="false" text="Role" />
                                                <TableColumn fx:id="colUserDob" editable="false" minWidth="300.0" prefWidth="300.0" reorderable="false" sortable="false" text="DOB" />

                                                <TableColumn fx:id="colUserAction" editable="false" maxWidth="80.0" minWidth="80.0" reorderable="false" sortable="false" text="Actions" />
                                            </columns>
                                            <styleClass>
                                                <String fx:value="modern-table" />
                                                <String fx:value="table-view" />
                                            </styleClass>
                                            <columnResizePolicy>
                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                            </columnResizePolicy>
                                        </TableView>
                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                            <children>
                                                <FontIcon iconLiteral="far-user" iconSize="18" styleClass="header-icon" />
                                                <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Manage Users" textFill="#2c3e50" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>

                                <VBox spacing="15.0">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                            <children>
                                                <FontIcon iconLiteral="far-image" iconSize="18" styleClass="header-icon" />
                                                <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Manage Auction Items" textFill="#2c3e50" />
                                            </children>
                                        </HBox>
                                        <TableView fx:id="itemTable" prefHeight="200.0" stylesheets="@TableStyle.css">
                                            <columns>
                                                <TableColumn fx:id="colItemName" editable="false" minWidth="250.0" prefWidth="250.0" reorderable="false" sortable="false" text="Item" />

                                                <TableColumn fx:id="colItemPrice" editable="false" minWidth="300.0" prefWidth="300.0" reorderable="false" sortable="false" text="Current Price" />
                                                <TableColumn fx:id="colItemStatus" editable="false" minWidth="300.0" prefWidth="300.0" reorderable="false" sortable="false" text="Status" />

                                                <TableColumn fx:id="colItemAction" editable="false" maxWidth="80.0" minWidth="80.0" reorderable="false" sortable="false" text="Actions" />
                                            </columns>
                                            <columnResizePolicy>
                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                            </columnResizePolicy>
                                            <styleClass>
                                                <String fx:value="modern-table" />
                                                <String fx:value="table-view" />
                                            </styleClass>
                                        </TableView>
                                    </children>
                                </VBox>
                            </children>
                     <padding>
                        <Insets left="90.0" right="90.0" top="30.0" />
                     </padding>
                        </VBox>
                    </content>
                </ScrollPane>
            </center>
        </BorderPane>
        <AnchorPane fx:id="overlayPane" opacity="0.21" prefHeight="200.0" prefWidth="200.0" style="-fx-background-color: #000000;" visible="false" />
    </children>
</StackPane>
