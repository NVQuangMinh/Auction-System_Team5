         <padding>
            <Insets left="30.0" right="30.0" top="25.0" />
         </padding>
         <effect>
            <DropShadow height="60.0" radius="29.5" width="60.0">
               <color>
                  <Color opacity="0.25" />
               </color>
            </DropShadow>
         </effect>
      </HBox>
   </children>
</StackPane>
