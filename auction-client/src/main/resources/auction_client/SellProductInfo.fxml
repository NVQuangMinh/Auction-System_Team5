                           <cursor>
                              <Cursor fx:constant="HAND" />
                           </cursor>
                        </Label>
                     </children>
                  </HBox>
                  <AnchorPane prefHeight="316.0" prefWidth="451.0" style="-fx-background-color: #f0f0f0; -fx-background-radius: 15; -fx-border-color: #dcdcdc; -fx-border-width: 2; -fx-border-radius: 15;">
                     <children>
                        <LineChart horizontalGridLinesVisible="false" layoutX="4.0" layoutY="4.0" legendVisible="false" prefHeight="316.0" prefWidth="451.0" style="-fx-background-color: transparent;" verticalGridLinesVisible="false" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
