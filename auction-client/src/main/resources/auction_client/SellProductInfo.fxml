<StackPane style="-fx-background-color: transparent;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="auction_client.controllers.SellProductInfoController">
   <padding>
      <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
   </padding>
   <children>
      <HBox prefHeight="500.0" prefWidth="1000.0" spacing="40.0" style="-fx-background-radius: 20; -fx-background-color: #f0f0f0;">
