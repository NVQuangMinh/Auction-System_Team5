                           </xAxis>
                           <yAxis>
                              <NumberAxis fx:id="yAxis" forceZeroInRange="false" side="LEFT" tickMarkVisible="false" />
                           </yAxis>
                        </LineChart>
                     </children>
                  </AnchorPane>
               </children>
            </VBox>
