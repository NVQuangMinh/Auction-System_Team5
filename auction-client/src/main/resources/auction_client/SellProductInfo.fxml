                        <HBox GridPane.halignment="CENTER" GridPane.hgrow="ALWAYS" GridPane.rowIndex="1" GridPane.valignment="TOP" GridPane.vgrow="ALWAYS">
                           <children>
                              <Label alignment="CENTER_RIGHT" prefHeight="124.0" prefWidth="170.0" style="-fx-font-size: 35; -fx-font-weight: bold;" text="\$" />
                              <Label fx:id="currentPrice" prefHeight="105.0" prefWidth="193.0" style="-fx-font-size: 35; -fx-font-weight: bold;" text="00" />
                           </children>
                           <padding>
                              <Insets bottom="10.0" />
                           </padding>
                        </HBox>
                        <HBox GridPane.columnIndex="1" GridPane.halignment="LEFT" GridPane.hgrow="ALWAYS" GridPane.rowIndex="1" GridPane.valignment="TOP" GridPane.vgrow="ALWAYS">
                           <children>
                              <Label alignment="CENTER_RIGHT" prefHeight="84.0" prefWidth="150.0" style="-fx-font-size: 35; -fx-font-weight: bold;" text="\$" />
                              <Label fx:id="buyOut" prefHeight="82.0" prefWidth="176.0" style="-fx-font-size: 35; -fx-font-weight: bold;" text="00" />
                           </children>
                           <padding>
                              <Insets bottom="10.0" />
                           </padding>
                        </HBox>
                        <HBox GridPane.columnIndex="2" GridPane.halignment="LEFT" GridPane.hgrow="ALWAYS" GridPane.rowIndex="1" GridPane.valignment="TOP" GridPane.vgrow="ALWAYS">
                           <children>
                              <Label alignment="CENTER_RIGHT" prefHeight="84.0" prefWidth="120.0" style="-fx-font-size: 35; -fx-font-weight: bold;" text="\$" />
                              <Label fx:id="tickRate" prefHeight="86.0" prefWidth="144.0" style="-fx-font-size: 35; -fx-font-weight: bold;" text="00" />
