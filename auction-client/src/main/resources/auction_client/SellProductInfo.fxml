            <VBox prefHeight="475.0" prefWidth="323.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label fx:id="itemName" prefHeight="57.0" prefWidth="498.0" style="-fx-font-size: 25; -fx-font-weight: bold;" text="Product Name" textFill="#fc5421">
                     <opaqueInsets>
                        <Insets />
                     </opaqueInsets>
                  </Label>
                  <Label fx:id="description" prefHeight="42.0" prefWidth="465.0" style="-fx-font-size: 16;" text="Description">
                     <VBox.margin>
                        <Insets bottom="14.0" />
                     </VBox.margin>
                  </Label>
                  <GridPane alignment="CENTER" prefHeight="141.0" prefWidth="458.0" style="-fx-background-color: #e9e4de; -fx-background-radius: 15;">
                     <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                     </columnConstraints>
                     <rowConstraints>
                        <RowConstraints maxHeight="48.0" minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints maxHeight="84.0" minHeight="10.0" prefHeight="57.0" vgrow="SOMETIMES" />
                     </rowConstraints>
                     <children>
                        <Label alignment="CENTER" prefHeight="25.0" prefWidth="129.0" style="-fx-font-weight: bold; -fx-font-size: 16;" text="Current Price" textAlignment="CENTER" textFill="#0000006a" GridPane.halignment="CENTER" GridPane.hgrow="ALWAYS" GridPane.valignment="BOTTOM" GridPane.vgrow="ALWAYS" />
                        <Label alignment="CENTER" prefHeight="25.0" prefWidth="169.0" style="-fx-font-weight: bold; -fx-font-size: 16;" text="Buy Out" textAlignment="CENTER" textFill="#0000006a" GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.hgrow="ALWAYS" GridPane.valignment="BOTTOM" GridPane.vgrow="ALWAYS" />
                        <Label alignment="CENTER" prefHeight="25.0" prefWidth="337.0" style="-fx-font-weight: bold; -fx-font-size: 16;" text="Tick Rate" textAlignment="CENTER" textFill="#0000006a" GridPane.columnIndex="2" GridPane.halignment="CENTER" GridPane.hgrow="ALWAYS" GridPane.valignment="BOTTOM" GridPane.vgrow="ALWAYS" />
