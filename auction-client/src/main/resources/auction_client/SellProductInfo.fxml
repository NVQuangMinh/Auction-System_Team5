                     </VBox.margin>
                     <padding>
                        <Insets left="5.0" right="5.0" />
                     </padding>
                  </GridPane>
               </children>
            </VBox>
            <VBox prefHeight="475.0" prefWidth="247.0" spacing="15.0" HBox.hgrow="ALWAYS">
