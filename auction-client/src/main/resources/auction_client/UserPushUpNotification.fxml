<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="50.0" prefWidth="437.0" style="-fx-background-radius: 8; -fx-background-color: #1a1e29;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="auction_client.controllers.UserPushUpNotificationController">
   <children>
      <HBox alignment="CENTER_LEFT" prefHeight="50.0" prefWidth="470.0" spacing="15.0" VBox.vgrow="ALWAYS">
         <children>
            <StackPane fx:id="iconContainer" prefHeight="50.0" prefWidth="50.0" />
            <Label fx:id="notificationLabel" prefHeight="17.0" style="-fx-font-size: 20; -fx-font-weight: bold;" text="Notification!" textFill="WHITE" HBox.hgrow="ALWAYS" />
         </children>
         <padding>
            <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
         </padding>
      </HBox>
      <ProgressBar fx:id="progressBar" prefHeight="11.0" prefWidth="200.0" progress="0.0" />
   </children>
</VBox>
