<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" onMouseClicked="#handleCardClick" prefHeight="350.0" prefWidth="260.0" style="-fx-background-color: F5F5F0; -fx-background-radius: 15; -fx-border-color: #D1D5DB; -fx-border-width: 2; -fx-border-radius: 15;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="auction_client.controllers.ProductCardController">
   <children>
      <HBox prefHeight="50.0" prefWidth="202.0">
         <children>
            <Label fx:id="itemName" prefHeight="152.0" prefWidth="345.0" style="-fx-font-size: 16; -fx-font-weight: bold;" text=" Item Name" textFill="#fe5721cc" HBox.hgrow="ALWAYS">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Label>
            <Region prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />
            <Label fx:id="itemState" alignment="CENTER_RIGHT" prefHeight="117.0" prefWidth="253.0" style="-fx-font-size: 16; -fx-font-weight: Bold;" text="STATE" textAlignment="CENTER" textFill="#fe5721" HBox.hgrow="ALWAYS">
               <font>
                  <Font size="14.0" />
               </font>
            </Label>
         </children>
         <VBox.margin>
            <Insets />
         </VBox.margin>
      </HBox>
      <StackPane fx:id="productImage" prefHeight="132.0" prefWidth="222.0" style="-fx-background-color: #e9e4de; -fx-background-radius: 15;">
         <VBox.margin>
            <Insets bottom="15.0" />
         </VBox.margin>
      </StackPane>
      <HBox maxHeight="90.0" prefWidth="222.0">
         <children>
            <VBox alignment="TOP_CENTER" prefWidth="100.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label alignment="CENTER" prefHeight="20.0" prefWidth="152.0" style="-fx-font-size: 14;" text="Current Price" textAlignment="CENTER" textFill="#9ca3af" />
                  <HBox alignment="CENTER" spacing="1.0">
                     <children>
                        <Label fx:id="currentPrice" style="-fx-font-size: 20; -fx-font-weight: bold;" text="00" wrapText="true" HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>
               </children>
            </VBox>
            <Separator depthTest="DISABLE" orientation="VERTICAL" prefHeight="180.0">
               <HBox.margin>
                  <Insets left="13.0" right="7.0" />
               </HBox.margin>
            </Separator>
            <VBox alignment="TOP_CENTER" prefWidth="100.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label alignment="CENTER" prefHeight="17.0" prefWidth="233.0" style="-fx-font-size: 14;" text="Buy Out" textFill="#9ca3af" />
                  <HBox alignment="CENTER" spacing="1.0">
                     <children>
                        <Label fx:id="buyOutPrice" style="-fx-font-size: 20; -fx-font-weight: bold;" text="00" wrapText="true" HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
         <VBox.margin>
            <Insets bottom="10.0" />
         </VBox.margin>
      </HBox>
      <Label fx:id="description" alignment="TOP_LEFT" prefHeight="62.0" prefWidth="202.0" text="Description" />
   </children>
   <padding>
      <Insets left="17.0" right="17.0" top="5.0" />
   </padding>
   <effect>
      <DropShadow offsetY="2.0">
         <color>
            <Color opacity="0.05000000074505806" />
         </color>
      </DropShadow>
   </effect>
   <cursor>
      <Cursor fx:constant="HAND" />
   </cursor>
</VBox>
