<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN" "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>

    <module name="FileTabCharacter">
        <property name="eachLine" value="true"/>
    </module>

    <module name="LineLength">
        <property name="max" value="250"/>
        <property name="ignorePattern" value="^package.*|^import.*|a href|href|http://|https://|ftp://"/>
    </module>

    <module name="TreeWalker">
        <module name="Indentation">
            <property name="basicOffset" value="4"/>        <property name="braceAdjustment" value="0"/>     <property name="caseIndent" value="4"/>          <property name="throwsIndent" value="8"/>        <property name="arrayInitIndent" value="4"/>     <property name="lineWrappingIndentation" value="4"/> </module>

        <module name="PackageName">
            <property name="format" value="^[a-zA-Z0-9_]+(\.[a-zA-Z0-9_]+)*$"/>
        </module>

        <module name="ConstantName">
            <property name="format" value="^[a-zA-Z0-9_]+$"/>
        </module>

        <module name="MethodName">
            <property name="format" value="^[a-zA-Z0-9_]+$"/>
        </module>
        <module name="TypeName">
            <property name="format" value="^[a-zA-Z0-9_]+$"/>
        </module>
        <module name="MemberName">
            <property name="format" value="^[a-zA-Z0-9_]+$"/>
        </module>
        <module name="LocalVariableName">
            <property name="format" value="^[a-zA-Z0-9_]+$"/>
        </module>
        <module name="ParameterName">
            <property name="format" value="^[a-zA-Z0-9_]+$"/>
        </module>
        <module name="LambdaParameterName">
            <property name="format" value="^[a-zA-Z0-9_]+$"/>
        </module>

        <module name="WhitespaceAround">
            <property name="allowEmptyMethods" value="false"/>
            <property name="allowEmptyTypes" value="false"/>
            <property name="allowEmptyConstructors" value="false"/>
        </module>
        <module name="WhitespaceAfter"/>
        <module name="NoWhitespaceBefore"/>

        <module name="UnusedImports"/>
        <module name="AvoidStarImport"/>
        <module name="RedundantImport"/>

        <module name="NeedBraces"/> <module name="LeftCurly"/>  <module name="RightCurly"/> <module name="EmptyCatchBlock"/>

        <module name="MethodLength">
            <property name="max" value="100"/>
        </module>
    </module>
</module>

<!--Định dạng & Giới hạn: File code bắt buộc dùng mã hóa UTF-8, thụt lề bằng Space , với giới hạn tối đa 250 ký tự trên mỗi dòng và 100 dòng cho mỗi hàm.-->

<!--Quy tắc đặt tên: Nới lỏng hoàn toàn cho mọi thành phần (package, class, hàm, biến, hằng số,...), cho phép kết hợp chữ hoa, chữ thường, số và dấu gạch dưới _.-->

<!--Quản lý Import: Bắt buộc dọn sạch code bẩn, nghiêm cấm việc import thư viện không sử dụng, import trùng lặp hoặc import gộp bằng dấu sao (.*).-->

<!--Căn lề & Khoảng trắng: Tuân thủ căn lề bằng 4 hoặc 8 space, đặt dấu cách hợp lý xung quanh các toán tử/từ khóa/dấu câu, và không được viết tắt gộp các khối lệnh rỗng trên cùng một dòng.-->

<!--Cấu trúc khối lệnh: Bắt buộc dùng dấu ngoặc nhọn { } đúng chuẩn vị trí cho mọi cấu trúc điều khiển và nghiêm cấm việc để trống khối catch -->